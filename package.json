{
  "name": "@fortemate/dicechess-tv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "prettier --write src native test *.json *.md docs/*.md .github/**/*.yml .github/**/*.yaml",
    "format:check": "prettier --check src native test *.json *.md docs/*.md .github/**/*.yml .github/**/*.yaml"
  },
  "dependencies": {
    "@fortemate/dicechess-engine": "0.12.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "prettier": "3.9.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "description": "Dice Chess for Amazon Fire TV. The application is in native/; this package holds the shared pure core it runs on and the piece artwork."
}
