{
  "name": "@fortemate/dicechess-tv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "prettier --write src test *.json *.ts *.js index.html README.md docs/prototype.md THIRD_PARTY_NOTICES.md .github/workflows/ci.yaml",
    "format:check": "prettier --check src test *.json *.ts *.js index.html README.md docs/prototype.md THIRD_PARTY_NOTICES.md .github/workflows/ci.yaml"
  },
  "dependencies": {
    "@fortemate/dicechess-engine": "0.12.2",
    "@lichess-org/chessground": "10.1.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  }
}
