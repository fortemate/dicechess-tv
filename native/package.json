{
  "name": "@fortemate/dicechess-tv-native",
  "version": "0.0.0",
  "private": true,
  "description": "Dice Chess for Fire TV: the React Native for Vega application. Typechecked and tested with the repository's own runner; packaged with the Vega SDK, see README.md.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --import ./test/hooks.mjs test/*.test.tsx test/*.test.ts",
    "splash": "node scripts/generate-splash.mjs",
    "build": "npm run splash && react-native build-vega --build-type Release",
    "build:debug": "npm run splash && react-native build-vega --build-type Debug",
    "start": "react-native start"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.1",
    "@amazon-devices/react-native-mmkv": "^1.0.11",
    "@amazon-devices/react-native-svg": "3.0.9000000001",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "0.28.2",
    "react-test-renderer": "19.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "kepler": {
    "projectType": "application",
    "appName": "DiceChessTV",
    "targets": [
      "tv"
    ]
  }
}
