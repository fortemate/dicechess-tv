{
  "name": "@fortemate/dicechess-tv-android-probe",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "check": "tsc --noEmit",
    "prebuild": "npm run assets && EXPO_TV=1 expo prebuild --platform android --no-install",
    "bundle": "npm run assets && expo export --platform android --output-dir build/export",
    "start": "expo start",
    "android": "expo run:android",
    "test": "npm run assets && node --experimental-strip-types --test test/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "expo": "55.0.32",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-modules-core": "~55.0.27",
    "react": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.10-1",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native/babel-preset": "0.83.10",
    "@types/react": "19.2.2",
    "babel-preset-expo": "55.0.25",
    "esbuild": "0.28.2",
    "typescript": "5.8.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "react",
        "react-native-worklets"
      ]
    }
  },
  "engines": {
    "node": ">=26.8.2 <27"
  }
}
