# Line endings: LF in the repository and in every checkout, whatever the platform
# or `core.autocrlf` says. Prettier writes LF, so a CRLF checkout would show every
# line of every file as changed.
* text=auto eol=lf

# Binary files are never converted, and their diffs are not shown as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.m4a   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.vpkg  binary

# Vendored sounds and their licences keep their upstream bytes on every platform.
# Kenney's licence files use CRLF; without this, `core.autocrlf` rewrites them on
# commit and the digests in native/sounds/sounds.lock.json stop matching a fresh
# clone. That happened once in dicechess-assets before it had the same rule.
# Vendored, so they stay out of the repository's language statistics too.
native/sounds/** -text linguist-vendored
native/splash/fonts/** -text linguist-vendored
# The voices, the bots' and the Hot Seat host's, and events.json beside them,
# pinned by native/voices/voices.json the same way (#159, #202).
native/voices/** -text linguist-vendored
# The music, pinned by native/music/music.json (#76), and Thinkle's narration of
# the demo video, pinned by scripts/demo-video/narration/narration.json.
native/music/** -text linguist-vendored
scripts/demo-video/narration/** -text linguist-vendored
# The licence texts, kept as published.
licenses/** -text

# Written by scripts rather than by hand: collapsed in pull-request diffs and left
# out of the language statistics. Change the script and regenerate instead.
native/src/pieces/*.tsx linguist-generated
native/src/faces/*.tsx  linguist-generated
native/src/cueFiles.ts  linguist-generated
native/src/voiceFiles.ts linguist-generated
src/core/hostPacing.ts linguist-generated
# The voice audition of /voices/ keeps its upstream bytes (#172).
site/public/voices/** -text linguist-vendored

# `git diff --check`, which CI runs on every change, reports no whitespace errors
# in third-party bytes: Kenney's licences end their lines in CRLF, and the font
# and RhosGFX licences have trailing spaces. Fixing them would break the digests.
native/sounds/**                 -whitespace
native/splash/fonts/**           -whitespace
native/voices/**                 -whitespace
native/music/**                  -whitespace
scripts/demo-video/narration/**  -whitespace
site/public/voices/**            -whitespace
licenses/**                      -whitespace
