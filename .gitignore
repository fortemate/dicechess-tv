# builds. Its licence is still pending, so no copy may be committed to this public
# repository yet. Remove this entry in the change that vendors licensed music.
native/music/
coverage/
# Written by Amazon's Vega ESLint plugin on every lint run.
native/generated/
# Types and caches Astro writes for the site in site/.
.astro/
*.vpkg
*.apk
*.log

