# Local environment and credentials
.env
.env.*
!.env.example
mise.local.toml

# Dependencies and generated outputs
node_modules/
build/
dist/
dist-vega/
# Written by `react-native build-vega` next to the manifest.
buildinfo.json
# Built by native/scripts/generate-assets.mjs, which deletes and rebuilds it on
# every build. Everything the package ships as artwork is built, not committed.
native/assets/
coverage/
# Written by Amazon's Vega ESLint plugin on every lint run.
native/generated/
# Types and caches Astro writes for the site in site/.
.astro/
*.vpkg
*.apk
*.log

# Local editor and OS files
.DS_Store
.idea/

