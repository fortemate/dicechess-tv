// The Cloudflare Worker that serves the site: static assets only, no script.
// .github/workflows/deploy-site.yaml deploys dist/, the site with the bench in
// it, from main. The account comes from the workflow's secrets, not from here.
{
  "name": "dicechess-tv",
  "compatibility_date": "2026-10-01",
  // The site's address. Wrangler treats this file as the source of truth for
  // routes, so a domain attached only in the dashboard would be dropped by the
  // next deploy. Attaching it needs Workers Routes and DNS edit rights on the
  // fortemate.com zone for the deploy token.
  "routes": [
    { "pattern": "dicechess-tv.fortemate.com", "custom_domain": true },
  ],
  // The first address, still cited in the published demo video and in other
  // repositories: keep serving it.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Starlight's 404 page, for any address that serves no page.
    "not_found_handling": "404-page",
  },
}
